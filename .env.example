# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/sosapient

# Server Configuration
PORT=5000
NODE_ENV=development

# Transactional email (contact form + job applications), sent through Brevo.
#
# Brevo is the ONLY email provider. Zoho hosts the company mailbox; Brevo sends
# the transactional mail. The sender below must be added and verified in Brevo,
# and sosapient.in must be authenticated there (SPF + DKIM) before it will
# deliver reliably. There is deliberately no Gmail/Zoho SMTP fallback.
#
# Create the API key at  https://app.brevo.com/settings/keys/api
# Add the sender at      https://app.brevo.com/senders
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=admin@sosapient.in
BREVO_SENDER_NAME=SoSapient
# Where new inquiries and job applications are delivered. Fixed on the server;
# the frontend can never influence this. Falls back to ADMIN_EMAIL when unset.
CONTACT_ADMIN_EMAIL=admin@sosapient.in
# Per-attempt timeout for the Brevo API call (ms). Defaults to 10000.
BREVO_TIMEOUT_MS=10000

# Admin sign-in address. Also the fallback recipient for contact notifications
# when CONTACT_ADMIN_EMAIL is not set.
ADMIN_EMAIL=admin@sosapient.in

# Canonical public site URL (used for sitemap, robots, canonical links; no trailing slash)
SITE_URL=https://sosapient.in

# Optional comma-separated override for CORS origins
CORS_ORIGINS=https://sosapient.in,https://www.sosapient.in

# JWT authentication (required)
# Use a long random secret in every environment. Never commit real values.
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Legacy: JWT_EXPIRES_IN is no longer used (kept for old deploys; access is now 15m + rotating refresh).
# JWT_EXPIRES_IN=7d

# First ADMIN account seeding (used only by `npm run seed:admin`; never trusted from public signup)
# ADMIN_EMAIL must be a valid email; ADMIN_PASSWORD must be at least 8 characters.
ADMIN_EMAIL=admin@sosapient.in
ADMIN_PASSWORD=change-me-to-a-strong-password
# Optional overrides for the seeded admin profile:
# ADMIN_USERNAME=admin
# ADMIN_MOBILE=9876543210
# ADMIN_FIRST_NAME=Admin
# ADMIN_LAST_NAME=User

# Legacy: ADMIN_API_KEY is no longer used for admin user authentication (user JWT + ADMIN role is the authority).
# Kept here only so old deploys fail visibly if still referenced; do not use for login flows.
# ADMIN_API_KEY=legacy-unused

# AI Chat Configuration (Optional - for enhanced AI responses)
# Get your free API key from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# Gemini RAG Chatbot (powers the website AI assistant: answers + embeddings)
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Blog comments: set to "true" to hold new comments for admin approval.
# When "false"/unset, comments are visible immediately (current behaviour).
COMMENTS_REQUIRE_APPROVAL=false

# Chatbot: global daily ceiling on POST /api/chatbot/message (LLM cost-abuse guard).
# 0 or unset = unlimited. Per-instance; resets at UTC midnight.
CHATBOT_DAILY_MAX=2000

# Google reCAPTCHA v2 (blocks bot submissions on public forms such as /api/career).
# Secret key ONLY lives on the server. Get it from the Google reCAPTCHA admin console.
# The matching public site key goes in the frontend as VITE_RECAPTCHA_SITE_KEY.
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
# Comma-separated hostnames the widget is allowed to be solved on (apex + www + local).
RECAPTCHA_ALLOWED_HOSTNAMES=sosapient.in,www.sosapient.in,localhost,127.0.0.1

# Uploaded images (blog featured images, comment avatars) are stored in MongoDB
# and served from /api/images/<id>, so they survive redeploys with no external
# service and no server disk. No configuration is required.
